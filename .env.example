# Copy this file to .env and fill in what you need. .env is read by app.py and by the
# tools/ scripts; it is git-ignored, so your password stays on this machine.
#
# A real environment variable always wins over a line here. OPENAI_API_KEY is already set for
# your Windows user, so it is left out below on purpose - set it here only if you would rather
# keep it in the file.
#
# Restart app.py after changing this file.

# Where "Push to MongoDB" sends things. Wrap it in quotes if the password contains # or spaces.
MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority"

# Optional - these are the defaults.
MONGODB_DB=questionbank
MONGODB_COLLECTION=questions

# Supabase Storage - where the question images go. With these set, a push uploads each picture to
# the bucket as <chapter>/<image id>.png and puts its public URL in the MongoDB records.
# Use the service role key: the anon key cannot write to storage. Make the bucket public, or the
# stored URLs will not open without a signed link.
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
SUPABASE_BUCKET=images

# Only used when the images go into MongoDB's own GridFS instead of Supabase
# (push_mongo.py --images gridfs): references become this prefix plus the image id.
MONGODB_IMAGE_URL=/files/

# Optional - the OpenAI model used for reading questions, topics and levels.
# OPENAI_LATEX_MODEL=gpt-5.4-mini
# OPENAI_API_KEY=sk-...

# The ingest session pushed chapters belong to; the app lists questions through it.
MONGODB_SESSION_ID=
